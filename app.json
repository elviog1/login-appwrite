{
  "expo": {
    "name": "LoginApp",
    "slug": "loginapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tree.png",
    "scheme": "loginapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/tree.png",
        "backgroundImage": "./assets/images/tree.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ideas"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tree.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tree.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c91f7659-fb30-4d38-8ad6-8755708f0b0d"
      },
      "router": {}
    }
  }
}
